            "type": "integer",
            "minimum": 0
          },
          "case_id": {
            "type": "integer",
            "minimum": 0
          },
          "actor": {
            "type": [
              "string",
              "null"
            ]
          },
          "actor_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "type": "string"
          },
          "payload": {
            "type": "object",
            "description": "Action-specific saved progress/identity metadata; original message text is not included."
