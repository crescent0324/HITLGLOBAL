          "status",
          "conversation_id",
          "conversation_kind",
          "resident",
          "contact",
          "owner",
          "origin",
          "reason",
          "message_risk",
          "created_at",
          "claimed_at",
          "closed_at",
          "close_note",
          "progress",
          "handoff",
          "due_at",
          "deadline_status",
          "overdue"
        ],
        "additionalProperties": false
      },
      "Statistics": {
        "type": "object",
        "properties": {
