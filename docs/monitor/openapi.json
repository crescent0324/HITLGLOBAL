      "Handoff": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "from_user": {
            "type": "string"
          },
          "from_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "to_user": {
            "type": "string"
          },
          "to_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "message_id": {
            "type": "integer",
            "minimum": 0
          },
          "stale": {
            "type": "boolean"
          },
          "valid": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "from_user",
          "from_name",
          "to_user",
          "to_name",
          "created_at",
          "message_id",
          "stale",
          "valid"
        ],
        "additionalProperties": false
      },
      "CaseSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "pending",
              "claimed",
              "closed"
            ]
          },
          "conversation_id": {
            "type": "string"
          },
          "conversation_kind": {
            "enum": [
              "internal",
              "contact"
            ]
          },
          "resident": {
            "$ref": "#/components/schemas/Resident"
          },
          "contact": {
            "$ref": "#/components/schemas/Contact"
          },
          "owner": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Owner"
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "message_risk": {
            "enum": [
              "低",
              "中",
              "高"
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "claimed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "closed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "close_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "progress": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Progress"
              },
              {
                "type": "null"
              }
            ]
          },
          "handoff": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Handoff"
              },
              {
                "type": "null"
              }
            ]
          },
          "due_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "deadline_status": {
            "enum": [
              "unset",
              "unverified"
            ]
          },
          "overdue": {
            "type": "null"
          }
        },
        "required": [
          "id",
          "status",
          "conversation_id",
          "conversation_kind",
          "resident",
          "contact",
          "owner",
          "origin",
          "reason",
          "message_risk",
          "created_at",
          "claimed_at",
          "closed_at",
          "close_note",
          "progress",
          "handoff",
          "due_at",
          "deadline_status",
          "overdue"
        ],
        "additionalProperties": false
      },
      "CaseDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "pending",
              "claimed",
              "closed"
            ]
          },
          "conversation_id": {
            "type": "string"
          },
          "conversation_kind": {
            "enum": [
              "internal",
              "contact"
            ]
          },
          "resident": {
            "$ref": "#/components/schemas/Resident"
          },
          "contact": {
            "$ref": "#/components/schemas/Contact"
          },
          "owner": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Owner"
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "message_risk": {
            "enum": [
              "低",
              "中",
              "高"
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "claimed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "closed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "close_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "progress": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DetailedProgress"
              },
              {
                "type": "null"
              }
            ]
          },
          "handoff": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Handoff"
              },
              {
                "type": "null"
              }
            ]
          },
