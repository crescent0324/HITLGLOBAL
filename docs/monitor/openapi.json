          "next_action": {
            "type": "string"
          },
          "waiting_for": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "next_action",
          "waiting_for",
          "revision",
          "updated_at"
        ],
        "additionalProperties": false
